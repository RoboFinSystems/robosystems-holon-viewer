        {
          "@id": "https://robosystems.ai/report/0001045810-26-000021/fact/139eef64-8b9e-5974-8794-d059cce2ddba",
          "@type": "rs:Fact",
          "element": "us-gaap:ContractWithCustomerAssetAndLiabilityTableTextBlock",
          "entity": "https://robosystems.ai/report/0001045810-26-000021/entity/0001045810",
