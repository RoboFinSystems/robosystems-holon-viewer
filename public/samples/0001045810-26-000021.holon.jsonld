        {
          "@id": "https://robosystems.ai/report/0001045810-26-000021/fact/fa4e7fef-ab95-598b-b4db-f592519cfd33",
          "@type": "rs:Fact",
          "element": "us-gaap:BusinessCombinationDisclosureTextBlock",
          "entity": "https://robosystems.ai/report/0001045810-26-000021/entity/0001045810",
          "factSet": "https://robosystems.ai/factset/cce5b1e442870c60",
          "factType": "nonnumeric",
          "internalId": "fa4e7fef-ab95-598b-b4db-f592519cfd33",
          "period": "https://robosystems.ai/report/0001045810-26-000021/period/0d52ffd1-0ab0-57b9-9004-ff51feef8ace",
          "stringValue": "Groq<div style=\"margin-bottom:9pt;text-align:justify\"><span style=\"color:#000000;font-family:'NVIDIA Sans',sans-serif;font-size:9pt;font-weight:400;line-height:120%\">In December 2025, we entered into a non‑exclusive license agreement with Groq, Inc., or Groq, for its language processing unit technology and hired certain Groq employees. No customer contracts, existing products, or equity interests were purchased. We recorded $14.4 billion of goodwill and a $2.5 billion developed technology intangible asset, valued using a cost‑to‑recreate methodology with a five‑year useful life. Goodwill, primarily attributable to the workforce and future development of the licensed technology, was recorded in the Compute &amp; Networking reporting unit. Total consideration consists of $13.0 billion paid at closing and $4 billion, inclusive of imputed interest, payable within one year included in Accrued and Other Current Liabilities on our Consolidated Balance Sheets. The goodwill is tax deductible. Pro forma results of operations have not been presented because the effect was not material.</span></div>"
        },
