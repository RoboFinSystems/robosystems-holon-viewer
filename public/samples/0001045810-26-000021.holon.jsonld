        {
          "@id": "https://robosystems.ai/report/0001045810-26-000021/fact/6b2d5736-825b-5284-b6dc-d87869a13568",
          "@type": "rs:Fact",
          "element": "us-gaap:CommitmentsAndContingenciesPolicyTextBlock",
          "entity": "https://robosystems.ai/report/0001045810-26-000021/entity/0001045810",
          "factSet": "https://robosystems.ai/factset/202db3e7f6457cef",
