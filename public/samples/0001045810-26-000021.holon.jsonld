          "@type": "rs:Fact",
          "decimals": "-6",
          "element": "us-gaap:PaymentsToAcquireEquitySecuritiesFvNi",
          "entity": "https://robosystems.ai/report/0001045810-26-000021/entity/0001045810",
          "factSet": "https://robosystems.ai/factset/3274bedcf6b66c3b",
          "factType": "numeric",
