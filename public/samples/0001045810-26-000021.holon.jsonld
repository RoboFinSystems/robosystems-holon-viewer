        {
          "@id": "https://robosystems.ai/report/0001045810-26-000021/fact/4be93535-3d03-53e5-ae85-786550c4fae7",
          "@type": "rs:Fact",
          "decimals": "-6",
          "dimension": "https://robosystems.ai/report/0001045810-26-000021/dimension/c47e3e8a6ba71221",
          "element": "us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod",
          "entity": "https://robosystems.ai/report/0001045810-26-000021/entity/0001045810",
          "factSet": [
            "https://robosystems.ai/factset/bb0481d769f2121b",
